# Copiar a .env y ajustar según el entorno.

# Cadena de conexión MySQL usada por Prisma y el backend.
# Al correr todo con docker-compose, el host "mysql" resuelve al contenedor de base de datos.
# Al correr el backend localmente (fuera de Docker), usar "localhost".
DATABASE_URL="mysql://biosafe:biosafe@localhost:3306/biosafe_erp"

# Credenciales del contenedor MySQL (docker-compose)
# MYSQL_PORT es el puerto expuesto en el host; el contenedor siempre usa 3306
# internamente. Si ya tienes un MySQL/MariaDB local en el puerto 3306, cambia
# MYSQL_PORT (p. ej. 3307) y ajusta DATABASE_URL, o usa directamente tu
# servidor local en vez del contenedor mysql de docker-compose.
MYSQL_ROOT_PASSWORD=biosafe_root
MYSQL_DATABASE=biosafe_erp
MYSQL_USER=biosafe
MYSQL_PASSWORD=biosafe
MYSQL_PORT=3306

# Backend
PORT=4100
NODE_ENV=development
